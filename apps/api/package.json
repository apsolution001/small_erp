{
  "name": "@ekaro/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --env-file ../../.env",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "db:generate": "NODE_OPTIONS=--conditions=@ekaro/source drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/infra/db/migrate.ts"
  },
  "dependencies": {
    "@ekaro/contracts": "workspace:*",
    "@ekaro/core": "workspace:*",
    "@nestjs-cls/transactional": "^4.0.1",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "^2.0.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "unplugin-swc": "^2.0.0"
  }
}
