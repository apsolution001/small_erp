# ---- API ----
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# Three DB roles (docs/standards/database.md). setup-local-db.sh creates them with these passwords.
DATABASE_URL_OWNER=postgres://ekaro_owner:ekaro_owner@localhost:5432/ekaro
DATABASE_URL_APP=postgres://ekaro_app:ekaro_app@localhost:5432/ekaro
DATABASE_URL_PLATFORM=postgres://ekaro_platform:ekaro_platform@localhost:5432/ekaro

REDIS_URL=redis://localhost:6379

# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=ekaro-api
JWT_AUDIENCE=ekaro-web
REFRESH_TOKEN_TTL_DAYS=30
# 32-byte key, base64, for TOTP secret encryption
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

GSP_PROVIDER=mock

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Ekaro <no-reply@ekaro.local>"

# ---- Web ----
VITE_API_BASE_URL=http://localhost:3000/api/v1
