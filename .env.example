# ---- API ----
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# Three DB roles (docs/standards/database.md). setup-local-db.sh creates them with these passwords.
DATABASE_URL_OWNER=postgres://ekaro_owner:ekaro_owner@localhost:5432/ekaro
DATABASE_URL_APP=postgres://ekaro_app:ekaro_app@localhost:5432/ekaro
DATABASE_URL_PLATFORM=postgres://ekaro_platform:ekaro_platform@localhost:5432/ekaro
# Max connections per pool (app and platform each).
DB_POOL_MAX=10
# API e2e tests reuse the URLs above on this database (must end in _test; default ekaro_test).
# Give each worktree its own: bash apps/api/scripts/setup-local-db.sh my_dev my_dev_test
# TEST_DB_NAME=ekaro_test
# Test log level (default silent).
# TEST_LOG_LEVEL=silent

REDIS_URL=redis://localhost:6379

# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=ekaro-api
JWT_AUDIENCE=ekaro-web
# Sessions end after SESSION_IDLE_DAYS without a refresh, and SESSION_ABSOLUTE_DAYS after login
# whatever the activity (ADR 0016).
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
# The refresh cookie is Secure by default; browsers drop Secure cookies over plain http, so local
# development over http turns it off. Must stay true in production.
REFRESH_COOKIE_SECURE=false
# 32-byte key, base64, for TOTP secret encryption
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# GSP adapter. `mock` is refused when NODE_ENV=production.
GSP_PROVIDER=mock

# Reverse proxies in front of the API (0 locally; 1 behind a single load balancer). The client IP
# for rate limits is read that many hops back in X-Forwarded-For. Required in production.
TRUST_PROXY_HOPS=0
# Rate limits per minute: per IP on auth routes, per email on login/signup, per IP on GSTIN lookup.
THROTTLE_AUTH_PER_MINUTE=20
THROTTLE_ACCOUNT_PER_MINUTE=10
THROTTLE_GSTIN_PER_MINUTE=10

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Ekaro <no-reply@ekaro.local>"

# ---- Web ----
# Vite does not read this file (its NODE_ENV would break production builds). Put web settings in
# apps/web/.env.local. Unset, the web calls /api/v1 on its own origin and the dev server proxies it
# to API_PROXY_TARGET (default http://localhost:3000). A separate origin needs APP_ORIGIN above.
# VITE_API_BASE_URL=http://localhost:3000/api/v1
